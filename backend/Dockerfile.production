# Render deployment configuration
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend:$PYTHONPATH

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    default-libmysqlclient-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
# Use the backend-scoped requirements file so builds from the backend context succeed
COPY backend/requirements.render.txt ./requirements.txt
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt

# Copy project files
COPY . .

# Create directories and verify Django project layout
RUN mkdir -p /app/logs /app/staticfiles && \
    test -f /app/backend/backend/__init__.py && \
    test -f /app/backend/manage.py

# Collect static files
RUN python /app/backend/manage.py collectstatic --noinput || true

EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health').read()"

CMD ["sh", "-c", "python /app/backend/manage.py migrate --noinput && exec daphne -b 0.0.0.0 -p 8080 backend.asgi:application"]
